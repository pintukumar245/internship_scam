# AI Configuration for Company Analysis
# Add ONE of these API keys to enable AI-powered company insights

# Option 1: Google Gemini API (Free tier available)
# Get it from: https://ai.google.dev/
# GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Groq API (Free tier, very fast)
# Get it from: https://console.groq.com/
# GROQ_API_KEY=your_groq_api_key_here

# Option 3: OpenAI API (Paid)
# Get it from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# EMAIL ALERTS CONFIGURATION (Optional)
# ============================================

# Gmail SMTP Settings (Recommended)
# 1. Create a Gmail account
# 2. Enable "Less secure app access" or use App Password
# 3. Get your App Password (16 characters)

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-16-chars

# Or use direct SMTP settings
# SENDER_EMAIL=your-email@gmail.com
# SENDER_PASSWORD=your-password
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# ============================================
# Instructions:
# ============================================
# 1. Copy this file to .env
# 2. Uncomment and fill in ONE AI API key above
# 3. (Optional) Uncomment and fill in email settings for alerts
# 4. Restart your Flask application
# 5. The system will now use AI and send email alerts

